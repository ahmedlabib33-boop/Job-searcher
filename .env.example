# Copy this file to .env and fill in what you have. Every key is optional:
# without any keys the app still shows remote jobs that are open to people in Egypt.

PORT=3000

# JSearch (Google for Jobs) — powers on-site job listings in Cairo, pulled from
# LinkedIn, Indeed, Wuzzuf, Bayt and company career pages.
# Get a free key at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=

# Where your key comes from: "rapidapi" (default) or "openwebninja"
# (a key from https://www.openwebninja.com/api/jsearch).
JSEARCH_PROVIDER=rapidapi
