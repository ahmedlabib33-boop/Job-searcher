# Copy this file to .env and fill in what you have. Every key is optional:
# without any keys the app still shows remote jobs that are open to people in Egypt
# (from Himalayas, We Work Remotely, Remote OK and Jobicy).
#
# On-site jobs in Cairo need at least one of the keys below. Each one you add
# brings in more jobs. All of them have a free plan.

PORT=3000

# JSearch: Google for Jobs (LinkedIn, Indeed, Wuzzuf, Bayt, company sites).
# Free key: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=
# "rapidapi" (default), or "openwebninja" for a key from https://www.openwebninja.com/api/jsearch
JSEARCH_PROVIDER=rapidapi

# SerpApi: a second route to Google Jobs. Free plan: 250 searches a month.
# Free key: https://serpapi.com/users/sign_up
SERPAPI_API_KEY=

# Careerjet: jobs from Egyptian job boards and company sites (careerjet.com.eg).
# Free key with a partner account: https://www.careerjet.com.eg/partners/
CAREERJET_API_KEY=
# Careerjet's code for its Egypt site. Change it only if Careerjet tells you to.
CAREERJET_LOCALE=en_EG

# Jooble: jobs from many job sites. Get the key on the EGYPT site so it returns
# jobs in Egypt: https://eg.jooble.org/api/about
# Note: a free Jooble key allows 500 requests in total (not per month).
JOOBLE_API_KEY=
# Only change this if Jooble tells you to use another address.
JOOBLE_HOST=jooble.org
